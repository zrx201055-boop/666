        if mf and mf.Visible then
            mf.Visible = false
            if mb then mb.Visible = true end
            toggle.Text = "显示悬浮窗"
        else
            if mf then mf.Visible = true end
            if mb then mb.Visible = false end
            toggle.Text = "隐藏悬浮窗"
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do
        pcall(ensureHideToggle)
    end
end)

