local A = {}

-- ★ 新增 "limbs_head" = 四肢 + 头部
local function gp(k)
    local c = LP.Character
    if not c then return {} end
    local L = {}
    local function add(ns)
        for _, n in ipairs(ns) do
            local p = c:FindFirstChild(n)
            if p and p:IsA("BasePart") then table.insert(L, p) end
        end
    end
    if k == "all" then
        add({"HumanoidRootPart", "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"})
    elseif k == "limbs_head" then
        add({"Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg"})
    elseif k == "head" then add({"Head"})
    elseif k == "right" then add({"Right Arm", "RightHand"})
    elseif k == "left" then add({"Left Arm", "LeftHand"})
    elseif k == "torso" then add({"Torso"})
    elseif k == "legs" then add({"Left Leg", "Right Leg"}) end
    return L
end

local function da()
    for px, gr in pairs(A) do
        pcall(function()
            if gr.fire then gr.fire:Destroy() end
            if gr.light then gr.light:Destroy() end
            if px and px.Parent then px:Destroy() end
        end)
    end
    A = {}
end

local function aa()
    da()
    if not S.on then return end
    for _, t in ipairs(gp(S.pos)) do
        local p = Instance.new("Part")
        p.Name = "FlameProxy"
        p.Size = Vector3.new(.1, .1, .1)
        p.Transparency = 1
        p.CanCollide = false
        p.Massless = true
        p.Anchored = false
        p.CFrame = t.CFrame * CFrame.new(S.ox, S.oy, S.oz)
        p.Parent = t
        local w = Instance.new("WeldConstraint")
        w.Part0 = t; w.Part1 = p; w.Parent = p
        local fi = Instance.new("Fire")
        fi.Color = Color3.fromRGB(80, 180, 255)
        fi.SecondaryColor = Color3.fromRGB(180, 220, 255)
        fi.Heat = 5; fi.Size = 5; fi.Parent = p
        local li = Instance.new("PointLight")
        li.Color = Color3.fromRGB(80, 180, 255)
        li.Brightness = 3; li.Range = 10; li.Parent = p
        A[p] = {fire = fi, light = li}
    end
end

