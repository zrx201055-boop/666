task.spawn(function()
    while task.wait(0.5) do
        local c = LP.Character
        if c and (tick() - respawnTime > 5) then
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local hd = c:FindFirstChild("Head")
                if hd then
                    if hd:IsA("MeshPart") then
                        headInfo = {
                            headType = "MeshPart", mesh = hd.MeshId, tex = hd.TextureID,
                            size = hd.Size, transparency = hd.Transparency,
                            ltm = hd.LocalTransparencyModifier,
                        }
                    elseif hd:IsA("Part") then
                        local sm = hd:FindFirstChildOfClass("SpecialMesh")
                        if sm then
                            headInfo = {
                                headType = "PartWithMesh", mesh = sm.MeshId, tex = sm.TextureId,
                                scale = sm.Scale, offset = sm.Offset,
                                transparency = hd.Transparency,
                                ltm = hd.LocalTransparencyModifier,
                            }
                        else
                            headInfo = {
                                headType = "Part",
                                transparency = hd.Transparency,
                                ltm = hd.LocalTransparencyModifier,
                            }
                        end
                    end
                    local faceDecal = hd:FindFirstChildOfClass("Decal")
                    if faceDecal then
                        headFace = {tex = faceDecal.Texture, cls = "Decal"}
                    else
                        local faceTex = hd:FindFirstChildOfClass("Texture")
                        if faceTex then headFace = {tex = faceTex.Texture, cls = "Texture"} end
                    end
                end

                local sh = c:FindFirstChildOfClass("Shirt")
                if sh and sh.ShirtTemplate ~= "" then clothingInfo.shirt = sh.ShirtTemplate end
                local pa = c:FindFirstChildOfClass("Pants")
                if pa and pa.PantsTemplate ~= "" then clothingInfo.pants = pa.PantsTemplate end
                local gr = c:FindFirstChildOfClass("ShirtGraphic")
                if gr and gr.Graphic ~= "" then clothingInfo.graphic = gr.Graphic end

                local currentWorn = {}
                for _, obj in ipairs(c:GetChildren()) do
                    if obj:IsA("MeshPart")
                        and (obj.Name:sub(1, 5) == "Item_" or obj.Name:sub(1, 10) == "CustomAcc_") then
                        local mount = nil
                        for _, n in ipairs({
                            "Head", "Torso", "HumanoidRootPart",
                            "Left Arm", "Right Arm", "Left Leg", "Right Leg",
                            "UpperTorso", "LowerTorso"
                        }) do
                            local p = c:FindFirstChild(n)
                            if p and (p.Position - obj.Position).Magnitude < 12 then
                                mount = n; break
                            end
                        end
                        if mount then
                            local mp = c:FindFirstChild(mount)
                            currentWorn[obj.Name] = {
                                name = obj.Name, mount = mount, mesh = obj.MeshId,
                                tex = obj.TextureID, size = obj.Size,
                                offset = mp.CFrame:ToObjectSpace(obj.CFrame),
                            }
                        end
                    end
                end
                wornList = currentWorn
            end
        end
    end
end)

