local function fireBtn(btn)
    if type(firesignal) == "function" then
        if pcall(function() firesignal(btn.MouseButton1Click) end) then return true end
    end
    if type(getconnections) == "function" then
        if pcall(function()
            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
                if c.Function then pcall(c.Function) end
            end
        end) then return true end
    end
    if pcall(function() btn:Activate() end) then return true end
    return false
end

local function collectWearButtons()
    local list = {}
    for _, btn in ipairs(sc:GetDescendants()) do
        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
            local txt = btn.Text or ""
            if txt:find("%[.-%]") then table.insert(list, btn) end
        end
    end
    return list
end

local function wearExternal()
    local n = 0
    for _, btn in ipairs(collectWearButtons()) do
        if fireBtn(btn) then n = n + 1 end
        task.wait(0.1)
    end
    return n
end

local function ch()
    local c = LP.Character
    if not c then return 0 end
    local n = 0
    for _, o in ipairs(c:GetDescendants()) do
        local isHair = false
        if o:IsA("Accessory") then
            local ok, at = pcall(function() return o.AccessoryType end)
            if ok and at == Enum.AccessoryType.Hair then isHair = true end
        end
        if not isHair then
            local nm = o.Name:lower()
            if nm:find("hair") or nm:find("白发") or nm:find("wig") then isHair = true end
        end
        if isHair then
            suppressedHair[o.Name] = true
            o:Destroy(); n = n + 1
        end
    end
    return n
end

local function ca()
    local c = LP.Character
    if not c then return 0, 0 end
    local n = 0
    for _, o in ipairs(c:GetChildren()) do
        if o.Name:sub(1, 5) == "Item_" or o.Name:sub(1, 10) == "CustomAcc_" then
            o:Destroy(); n = n + 1
        end
    end
    local hn = ch(); n = n + hn
    for _, cls in ipairs({"Shirt", "Pants", "ShirtGraphic"}) do
        local x = c:FindFirstChildOfClass(cls)
        if x then x:Destroy(); n = n + 1 end
    end
    return n, hn
end

local function rewearAll()
    ca()
    task.wait(0.4)
    wearExternal()
end

