LP.CharacterAdded:Connect(function(newChar)
    respawnTime = tick()
    task.wait(2)
    local hum = newChar:FindFirstChildOfClass("Humanoid")
    if hum then
        local t0 = tick()
        while hum.Health <= 0 and (tick() - t0) < 3 do task.wait(0.1) end
    end
    task.wait(0.3)

    if S.keepAppearance then
        local hd = newChar:FindFirstChild("Head")
        if hd and headInfo then
            if headInfo.headType == "MeshPart" and hd:IsA("MeshPart") then
                hd.MeshId = headInfo.mesh; hd.TextureID = headInfo.tex; hd.Size = headInfo.size
            elseif headInfo.headType == "PartWithMesh" and hd:IsA("Part") then
                local sm = hd:FindFirstChildOfClass("SpecialMesh")
                if not sm then sm = Instance.new("SpecialMesh"); sm.Name = "Mesh"; sm.Parent = hd end
                sm.MeshId = headInfo.mesh; sm.TextureId = headInfo.tex
                sm.Scale = headInfo.scale; sm.Offset = headInfo.offset
            end
            if headInfo.transparency ~= nil then
                hd.Transparency = headInfo.transparency
                hd.LocalTransparencyModifier = headInfo.ltm
            end
            if headFace and headInfo.transparency and headInfo.transparency < 0.5 then
                for _, o in ipairs(hd:GetChildren()) do
                    if o:IsA("Decal") or o:IsA("Texture") then o:Destroy() end
                end
                local fd = Instance.new(headFace.cls)
                fd.Texture = headFace.tex; fd.Name = "Face"; fd.Parent = hd
            end
            task.spawn(function()
                for _ = 1, 50 do
                    task.wait(0.1)
                    if not S.keepAppearance then break end
                    local cur = LP.Character
                    if not cur then break end
                    local h = cur:FindFirstChild("Head")
                    if h and headInfo.transparency ~= nil then
                        h.Transparency = headInfo.transparency
                        h.LocalTransparencyModifier = headInfo.ltm
                    end
                end
            end)
        end

        if clothingInfo.shirt then
            local sh = newChar:FindFirstChildOfClass("Shirt")
            if not sh then sh = Instance.new("Shirt"); sh.Parent = newChar end
            sh.ShirtTemplate = clothingInfo.shirt
        end
        if clothingInfo.pants then
            local pa = newChar:FindFirstChildOfClass("Pants")
            if not pa then pa = Instance.new("Pants"); pa.Parent = newChar end
            pa.PantsTemplate = clothingInfo.pants
        end
        if clothingInfo.graphic then
            local gr = newChar:FindFirstChildOfClass("ShirtGraphic")
            if not gr then gr = Instance.new("ShirtGraphic"); gr.Parent = newChar end
            gr.Graphic = clothingInfo.graphic
        end

        for _, o in ipairs(newChar:GetDescendants()) do
            if suppressedHair[o.Name] then o:Destroy() end
        end

        for name, info in pairs(wornList) do
            local mount = newChar:FindFirstChild(info.mount)
            if mount and mount:IsA("BasePart") then
                local h = Instance.new("MeshPart")
                h.Name = name; h.MeshId = info.mesh; h.TextureID = info.tex
                h.Size = info.size; h.CanCollide = false; h.Massless = true
                h.Anchored = false; h.CFrame = mount.CFrame * info.offset
                h.Parent = newChar
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = mount; weld.Part1 = h; weld.Parent = h
            end
        end
    end

    task.wait(0.3)
    if S.on then da(); aa() end
end)

