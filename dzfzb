local SAVE_DIR="AnimSaves"
if not isfolder(SAVE_DIR) then makefolder(SAVE_DIR) end

local function collect()
    local t,seen={},{}
    local function add(r)
        if not r then return end
        for _,o in ipairs(r:GetDescendants()) do
            if o:IsA("Animation") and not seen[o] then
                seen[o]=true; table.insert(t,o)
            end
        end
    end
    add(lp.Character); add(lp:FindFirstChild("PlayerScripts"))
    return t
end

local function refresh()
    local c=lp.Character
    if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    local a=h and h:FindFirstChildOfClass("Animator")
    if a then pcall(function() for _,t in ipairs(a:GetPlayingAnimationTracks()) do t:Stop(0) end end) end
    local an=c:FindFirstChild("Animate")
    if an and an:IsA("BaseScript") then an.Disabled=true task.wait(0.05) an.Disabled=false end
end

local function slots()
    local s={}
    for _,a in ipairs(collect()) do
        local pn=a.Parent and a.Parent.Name or "?"
        local k=pn.."/"..a.Name
        if not s[k] then s[k]=tostring(a.AnimationId):match("%d+") or "" end
    end
    return s
end

local function apply(s)
    local n=0
    for _,a in ipairs(collect()) do
        local pn=a.Parent and a.Parent.Name or "?"
        local k=pn.."/"..a.Name
        if s[k] and s[k]~="" then
            local tgt="rbxassetid://"..s[k]
            if a.AnimationId~=tgt then pcall(function() a.AnimationId=tgt end) n=n+1 end
        end
    end
    refresh()
    return n
end

local function listSaves()
    local o={}
    local ok,f=pcall(listfiles,SAVE_DIR)
    if ok and f then for _,p in ipairs(f) do local n=p:match("([^/\\]+)%.json$") if n then table.insert(o,n) end end end
    table.sort(o)
    return o
end

