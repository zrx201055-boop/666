local function findMotorForPart(p)
    if not p or not p.Parent then return nil end
    for _,m in ipairs(p.Parent:GetChildren()) do
        if m:IsA("Motor6D") and m.Part1==p then return m end
    end
    for _,m in ipairs(p:GetChildren()) do
        if m:IsA("Motor6D") and m.Part1==p then return m end
    end
    return nil
end

local function getWA(n) if n:find("Arm") or n:find("Hand") then return "Z" end return "X" end
local function saveBase()
    local c=lp.Character if not c then return end
    baseSizes={} origAtt={} origMotorC0={}
    for _,n in ipairs(R15) do
        local p=c:FindFirstChild(n)
        if p and p:IsA("BasePart") then
            baseSizes[n]=p.Size
            for _,a in ipairs(p:GetChildren()) do
                if a:IsA("Attachment") then origAtt[a]=a.Position end
            end
            local m=findMotorForPart(p)
            if m then origMotorC0[m]=m.C0 end
        end
    end
end
local function getScaleOf(n)
    if n=="HumanoidRootPart" then return Vector3.new(1,1,1) end
    if enabledParts[n]==false then return Vector3.new(1,1,1) end
    if n=="Head" then return Vector3.new(headScale,headScale,headScale) end
    local wa=getWA(n)
    if wa=="X" then return Vector3.new(rW,rT,rD) else return Vector3.new(rD,rT,rW) end
end
local function applyScale()
    local c=lp.Character if not c then return end
    for _,n in ipairs(R15) do
        local p=c:FindFirstChild(n)
        if p and p:IsA("BasePart") and baseSizes[n] then
            local b=baseSizes[n]
            local tgt=dumpSize[n] or b
            local s=getScaleOf(n)
            local ps=partScale[n] or Vector3.new(1,1,1)
            local sx,sy,sz=tgt.X*s.X*ps.X,tgt.Y*s.Y*ps.Y,tgt.Z*s.Z*ps.Z
            pcall(function() p.Size=Vector3.new(sx,sy,sz) end)
            local rX=sx/b.X local rY=sy/b.Y local rZ=sz/b.Z
            local off=partOffset[n] or Vector3.new(0,0,0)
            for a,o in pairs(origAtt) do
                if a.Parent==p then
                    pcall(function() a.Position=Vector3.new(o.X*rX+off.X,o.Y*rY+off.Y,o.Z*rZ+off.Z) end)
                end
            end
            local m=findMotorForPart(p)
            if m and origMotorC0[m] then
                local rot=partRotation[n] or Vector3.new(0,0,0)
                local rotCF=CFrame.Angles(math.rad(rot.X),math.rad(rot.Y),math.rad(rot.Z))
                pcall(function() m.C0=origMotorC0[m]*rotCF end)
            end
        end
    end
end
