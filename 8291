local function replaceBody(it)
    local c=lp.Character if not c then return false end
    local p=c:FindFirstChild(it.part) if not p or not p:IsA("MeshPart") then return false end
    if not it.originalMesh then it.originalMesh={mesh=p.MeshId,tex=p.TextureID} end
    if it.mesh and it.mesh~="" then pcall(function() p.MeshId=it.mesh end) end
    if it.tex and it.tex~="" then pcall(function() p.TextureID=it.tex end) end
    if it.size then dumpSize[it.part]=it.size end
    applyScale()
    it.isReplaced=true return true
end
local function restoreBody(it)
    local c=lp.Character if not c then return false end
    local p=c:FindFirstChild(it.part) if not p or not p:IsA("MeshPart") then return false end
    if it.originalMesh then pcall(function() p.MeshId=it.originalMesh.mesh p.TextureID=it.originalMesh.tex end) end
    dumpSize[it.part]=nil
    applyScale()
    it.isReplaced=false return true
end
local rebuild
rebuild=function()
    for _,c in ipairs(sc:GetChildren()) do if c:IsA("TextButton") or c:IsA("TextLabel") or c:IsA("Frame") then c:Destroy() end end
    local order=1
    mkSec("体型调整",order) order=order+1
