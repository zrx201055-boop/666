local function parseDump(text)
    local accItems={} local bodyData={} local current=nil
    local function flush()
        if not current then return end
        if current.className=="Accessory" then table.insert(accItems,current)
        elseif current.className=="MeshPart" and R15SET[current.name] then bodyData[current.name]={mesh=current.mesh,tex=current.tex,size=current.sizeVec}
        elseif current.className=="Shirt" and current.url then table.insert(accItems,{name="衬衫",type="Shirt",url=current.url,mesh="",tex="",size=Vector3.new(0,0,0)})
        elseif current.className=="Pants" and current.url then table.insert(accItems,{name="裤子",type="Pants",url=current.url,mesh="",tex="",size=Vector3.new(0,0,0)})
        elseif current.className=="ShirtGraphic" and current.url then table.insert(accItems,{name="T恤",type="ShirtGraphic",url=current.url,mesh="",tex="",size=Vector3.new(0,0,0)}) end
        current=nil
    end
    for line in text:gmatch("[^\r\n]+") do
        local name,className
        local aN=line:match("%[Accessory%]%s+Accessory%s+%((.-)%)")
        if aN then name=aN className="Accessory"
        elseif line:match("%[Accessory%]") then name=line:match("%[Accessory%]%s+(.+)") or "未命名" className="Accessory"
        elseif line:match("%[MeshPart%]") then name=line:match("%[MeshPart%]%s+(.+)") or "MeshPart" className="MeshPart"
        elseif line:match("%[Shirt%]") then name="Shirt" className="Shirt"
        elseif line:match("%[Pants%]") then name="Pants" className="Pants"
        elseif line:match("%[ShirtGraphic%]") then name="ShirtGraphic" className="ShirtGraphic" end
        if name then flush() current={name=name,className=className}
        elseif current then
            if current.className=="Shirt" then local u=line:match("Shirt:%s*(%S+)") if u and u~="" then current.url=u end
            elseif current.className=="Pants" then local u=line:match("Pants:%s*(%S+)") if u and u~="" then current.url=u end
            elseif current.className=="ShirtGraphic" then local u=line:match("Graphic:%s*(%S+)") if u and u~="" then current.url=u end
            else
                local t=line:match("Type:%s*Enum%.AccessoryType%.(%w+)") if t then current.type=t end
                local hm=line:match("Handle%.MeshId:%s*(%S+)") if hm then current.mesh=hm end
                local ht=line:match("Handle%.Tex:%s*(%S+)") if ht and ht~="" then current.tex=ht end
                local hsz=line:match("Handle%.Size:%s*(.+)") if hsz then current.sizeStr=hsz end
                if not current.mesh then local m=line:match("MeshId:%s*(%S+)") if m then current.mesh=m end end
                if not current.tex then local t2=line:match("Tex:%s*(%S+)") if t2 and t2~="" then current.tex=t2 end end
                if not current.sizeStr then local s=line:match("Size:%s*(.+)") if s then current.sizeStr=s end end
                if current.sizeStr then local sx,sy,sz=current.sizeStr:match("([%d%.%-]+),%s*([%d%.%-]+),%s*([%d%.%-]+)") if sx then current.sizeVec=Vector3.new(tonumber(sx),tonumber(sy),tonumber(sz)) end end
            end
        end
    end
    flush()
    local res={}
    for _,it in ipairs(accItems) do
        if it.type=="Shirt" or it.type=="Pants" or it.type=="ShirtGraphic" then
            if it.url then initAcc(it) table.insert(res,it) end
        elseif it.mesh and it.sizeVec then
            it.size=it.sizeVec it.type=it.type or "MeshPart" it.mount=MP[it.type] or "UpperTorso"
            initAcc(it) table.insert(res,it)
        end
    end
    return res,bodyData
end

