local function listSaveFiles()
    local out = {}
    local ok2, files = pcall(listfiles, SAVE_DIR)
    if ok2 and files then
        for _, p in ipairs(files) do
            local name = p:match("([^/\\]+)%.json$")
            if name then table.insert(out, name) end
        end
    end
    table.sort(out)
    return out
end

local function v3ToT(v) if not v then return nil end return {X=v.X,Y=v.Y,Z=v.Z} end
local function tToV3(t) if not t then return nil end return Vector3.new(tonumber(t.X) or 0, tonumber(t.Y) or 0, tonumber(t.Z) or 0) end

local function collectData()
    local data = {
        __ver = 3,
        __dump = dIn.Text,
        __headScale = headScale,
        __rW = rW, __rT = rT, __rD = rD,
        __moveStep = moveStep,
        __keepRespawn = keepRespawn,
        __enabled = {},
        __accList = {},
        __ps = {},
        __po = {},
        __pr = {},
        __body = {},
    }
    for k, v in pairs(enabledParts) do data.__enabled[k] = v end

    for _, it in ipairs(ACC) do
        table.insert(data.__accList, {
            nm = it.name,
            t  = it.type,
            m  = it.mesh,
            x  = it.tex,
            u  = it.url,
            nt = it.mount,
            sz = v3ToT(it.size),
            oX = it.oX, oY = it.oY, oZ = it.oZ,
            sX = it.sx, sY = it.sy, sZ = it.sz,
            rX = it.rX, rY = it.rY, rZ = it.rZ,
            st = it.step,
            wr = it.isWorn and 1 or 0,
        })
    end

    for _, n in ipairs(R15) do
        data.__ps[n] = v3ToT(partScale[n])
        data.__po[n] = v3ToT(partOffset[n])
        data.__pr[n] = v3ToT(partRotation[n])
    end

    for _, it in ipairs(BODY) do
        if it.mesh or it.tex or it.size then
            data.__body[it.name] = {
                mesh = it.mesh,
                tex  = it.tex,
                size = v3ToT(it.size)
            }
        end
    end

    return data
end

local function applyData(d)
    if d.__headScale then headScale = d.__headScale end
    if d.__rW then rW = d.__rW end
    if d.__rT then rT = d.__rT end
    if d.__rD then rD = d.__rD end
    if d.__moveStep then moveStep = d.__moveStep end
    if d.__keepRespawn ~= nil then keepRespawn = d.__keepRespawn end

    if d.__enabled then
        for k, v in pairs(d.__enabled) do enabledParts[k] = v end
    end

    local rewornList = {}

    if d.__accList or d.__acc then
        for _, it in ipairs(ACC) do
            if it.conn then it.conn:Disconnect() it.conn=nil end
            if it.handle then it.handle:Destroy() it.handle=nil end
            it.isWorn = false
        end

        local newACC = {}
        if d.__accList then
            for _, s in ipairs(d.__accList) do
                local it = {
                    name = s.nm or "配件",
                    type = s.t,
                    mesh = s.m,
                    tex  = s.x,
                    url  = s.u,
                    mount= s.nt,
                    size = tToV3(s.sz) or Vector3.new(0,0,0),
                }
                initAcc(it)
                it.oX,it.oY,it.oZ = s.oX or 0, s.oY or 0, s.oZ or 0
                it.sx,it.sy,it.sz = s.sX or 1, s.sY or 1, s.sZ or 1
                it.rX,it.rY,it.rZ = s.rX or 0, s.rY or 0, s.rZ or 0
                it.step = s.st or 0.1
                if s.wr == 1 then table.insert(rewornList, it) end
                table.insert(newACC, it)
            end
        elseif d.__acc then
            local order = d.__accOrder
            if order and #order > 0 then
                for _, name in ipairs(order) do
                    local s = d.__acc[name]
                    if s then
                        local it = {
                            name = s.nm or name,
                            type = s.t, mesh = s.m, tex = s.x, url = s.u,
                            mount = s.nt, size = tToV3(s.sz) or Vector3.new(0,0,0),
                        }
                        initAcc(it)
                        it.oX,it.oY,it.oZ = s.oX or 0, s.oY or 0, s.oZ or 0
                        it.sx,it.sy,it.sz = s.sX or 1, s.sY or 1, s.sZ or 1
                        it.rX,it.rY,it.rZ = s.rX or 0, s.rY or 0, s.rZ or 0
                        it.step = s.st or 0.1
                        table.insert(newACC, it)
                    end
                end
            else
                for name, s in pairs(d.__acc) do
                    local it = {
                        name = s.nm or name,
                        type = s.t, mesh = s.m, tex = s.x, url = s.u,
                        mount = s.nt, size = tToV3(s.sz) or Vector3.new(0,0,0),
                    }
                    initAcc(it)
                    it.oX,it.oY,it.oZ = s.oX or 0, s.oY or 0, s.oZ or 0
                    it.sx,it.sy,it.sz = s.sX or 1, s.sY or 1, s.sZ or 1
                    it.rX,it.rY,it.rZ = s.rX or 0, s.rY or 0, s.rZ or 0
                    it.step = s.st or 0.1
                    table.insert(newACC, it)
                end
            end
        end
        ACC = newACC
    end

    for _, n in ipairs(R15) do
        if d.__ps and d.__ps[n] then partScale[n] = tToV3(d.__ps[n]) or Vector3.new(1,1,1) end
        if d.__po and d.__po[n] then partOffset[n] = tToV3(d.__po[n]) or Vector3.new(0,0,0) end
        if d.__pr and d.__pr[n] then partRotation[n] = tToV3(d.__pr[n]) or Vector3.new(0,0,0) end
    end

    if d.__body then
        for _, it in ipairs(BODY) do
            local s = d.__body[it.name]
            if s then
                it.mesh = s.mesh
                it.tex  = s.tex
                it.size = tToV3(s.size)
            else
                it.mesh, it.tex, it.size = nil, nil, nil
            end
            it.isReplaced = false
            it.originalMesh = nil
        end
        dumpSize = {}
        for _, it in ipairs(BODY) do
            if it.size then dumpSize[it.part] = it.size end
        end
    end

    if d.__dump and type(d.__dump) == "string" then
        dIn.Text = d.__dump
    end

    applyScale()
    rebuild()

    if #rewornList > 0 then
        task.spawn(function()
            task.wait(0.4)
            for _, it in ipairs(rewornList) do
                pcall(wear, it, nil)
            end
            pcall(applyScale)
            pcall(rebuild)
        end)
    end
end

