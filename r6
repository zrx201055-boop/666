-- 按钮识别
-- ============================================================
local myBtnNames = {
    FLAME_TOGGLE=true, FLAME_APPLY=true, FLAME_RESETCOLOR=true,
    WEAR_ALL=true, WEAR_NONE=true, WEAR_FLAME=true, WEAR_DEFAULT=true,
    WEAR_DEFCLEAR=true,
}

local function isAccessoryBtn(btn)
    if not btn:IsA("TextButton") then return false end
    if myBtnNames[btn.Name] then return false end
    local t = btn.Text or ""
    local hasDot = t:find("●") or t:find("○")
    local hasType = t:match("%[.-%]")
    return hasDot and hasType
end

local function isWorn(btn)
    local t = btn.Text or ""
    return t:find("●") ~= nil
end

local function clickAllAccessoryBtns(wear)
    local btns = {}
    for _, btn in ipairs(sc:GetDescendants()) do
        if isAccessoryBtn(btn) then
            local worn = isWorn(btn)
            if (wear and not worn) or (not wear and worn) then
                table.insert(btns, btn)
            end
        end
    end
    local count = 0
    for i, btn in ipairs(btns) do
        local ok = pcall(function() btn:Activate() end)
        if ok then count = count + 1 end
        task.wait(0.06)
    end
    return count
end

