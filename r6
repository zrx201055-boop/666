}

local DOFF = {
    Hat={0,0.6,0}, Hair={0,0.2,0}, Face={0,0,-0.4}, Neck={0,-0.2,0},
    Shoulder={0,0,0}, Front={0,0,-0.4}, Back={0,0,0.5},
    Waist={0,-0.2,0}, Jacket={0,0,0}, MeshPart={0,0,0},
}
local MP = {
    Hat="Head", Hair="Head", Face="Head", Neck="Head",
    Shoulder="Torso", Front="Torso", Back="Torso",
    Waist="Torso", Jacket="Torso", MeshPart="Torso",
}

local customItems = {}

local function wearCustomItem(item)
    local char = LP.Character
    if not char then return false end
    local mount = MP[item.type] or "Torso"
    local target = char:FindFirstChild(mount) or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    if not target then return false end
    local off = DOFF[item.type] or {0,0,0}

    local h = Instance.new("MeshPart")
    h.Name = "CustomAcc_" .. item.name
    h.MeshId = item.mesh
    h.TextureID = item.tex or ""
    h.Size = item.size
    h.CanCollide = false
    h.Massless = true
    h.Anchored = true
    h.Parent = char

    local conn = RS.RenderStepped:Connect(function()
        if not h or not h.Parent then conn:Disconnect() return end
        local cc = LP.Character
        if not cc then return end
        local pp = cc:FindFirstChild(mount) or cc:FindFirstChild("Torso") or cc:FindFirstChild("HumanoidRootPart")
        if not pp then return end
        h.CFrame = pp.CFrame * CFrame.new(off[1], off[2], off[3])
    end)

    table.insert(customItems, { handle = h, conn = conn, name = item.name })
    return true
end

local function clearCustomItems()
    for _, it in ipairs(customItems) do
        pcall(function()
            if it.conn then it.conn:Disconnect() end
            if it.handle then it.handle:Destroy() end
        end)
    end
    customItems = {}
end

local function wearAllDefault()
    local count = 0
    for _, item in ipairs(DEFAULT_ACC) do
        local ok = wearCustomItem(item)
        if ok then count = count + 1 end
        task.wait(0.05)
    end
    return count
end

-- ============================================================
-- ★★★ 照搬 R15 版脱衣逻辑 ★★★
-- ============================================================
local function cleanCharacter()
    local c = LP.Character
    if not c then return 0 end
    local n = 0

    -- ① 用 Accoutrement 父类一次抓所有 3D 饰品（涵盖 Accessory + Hat）
    for _, obj in ipairs(c:GetChildren()) do
        if obj:IsA("Accoutrement") then
            obj:Destroy()
            n = n + 1
        end
    end

    -- ② 清 2D 服装
    for _, cls in ipairs({"Shirt","Pants","ShirtGraphic"}) do
        local o = c:FindFirstChildOfClass(cls)
        if o then
            o:Destroy()
            n = n + 1
        end
    end

    -- ③ 清脚本自己加上的配件（Item_ 和 CustomAcc_ 前缀）
    for _, obj in ipairs(c:GetChildren()) do
        if obj.Name:sub(1,5) == "Item_" or obj.Name:sub(1,10) == "CustomAcc_" then
            obj:Destroy()
            n = n + 1
        end
    end

    -- ④ 断开我们自己创建的 RenderStepped 连接 + 清句柄
    for _, it in ipairs(customItems) do
        if it.conn then
            pcall(function() it.conn:Disconnect() end)
        end
    end
    customItems = {}

    return n
end

