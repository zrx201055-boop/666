-- 火焰核心
-- ============================================================
local function parseColor(str)
    local r, g, b = str:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
    if r and g and b then return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) end
    return Color3.fromRGB(80, 180, 255)
end

local function findPart(key)
    local char = LP.Character
    if not char then return {} end
    local function get(names)
        local r = {}
        for _, n in ipairs(names) do
            local p = char:FindFirstChild(n)
            if p and p:IsA("BasePart") then table.insert(r, p) end
        end
        return r
    end
    if key == "all" then
        local list = {}
        for _, n in ipairs({"HumanoidRootPart","Head","Torso","UpperTorso","LowerTorso",
            "Left Arm","Right Arm","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm",
            "Left Leg","Right Leg","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg",
            "LeftHand","RightHand","LeftFoot","RightFoot"}) do
            local p = char:FindFirstChild(n)
            if p and p:IsA("BasePart") then table.insert(list, p) end
        end
        return list
    elseif key == "head" then return get({"Head"})
    elseif key == "right" then return get({"RightHand","Right Arm","RightLowerArm","RightUpperArm"})
    elseif key == "left" then return get({"LeftHand","Left Arm","LeftLowerArm","LeftUpperArm"})
    elseif key == "torso" then return get({"UpperTorso","Torso","LowerTorso"})
    elseif key == "legs" then return get({"LeftFoot","RightFoot","Left Leg","Right Leg","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg"})
    end
    return {}
end

local function makeProxy(targetPart)
    local proxy = Instance.new("Part")
    proxy.Name = "BlueFlameProxy"
    proxy.Size = Vector3.new(0.1,0.1,0.1)
    proxy.Transparency = 1
    proxy.CanCollide = false
    proxy.Massless = true
    proxy.Anchored = false
    proxy.CFrame = targetPart.CFrame
    proxy.Parent = targetPart
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = targetPart
    weld.Part1 = proxy
    weld.Parent = proxy
    return proxy
end

local function buildFire(proxy)
    local color = parseColor(state.color)
    local size = tonumber(state.size) or 5
    local count = tonumber(state.count) or 30
    local group = { proxy = proxy }

    local fire = Instance.new("Fire")
    fire.Name = "LocalBlueFire"
    fire.Color = color
    fire.SecondaryColor = Color3.fromRGB(180,220,255)
    fire.Heat = 5
    fire.Size = size
    fire.Parent = proxy
    group.fire = fire

    local attach = Instance.new("Attachment")
    attach.Name = "LocalBlueFlameAttachment"
    attach.Parent = proxy

    local particle = Instance.new("ParticleEmitter")
    particle.Name = "LocalBlueFlameParticle"
    particle.Texture = "rbxassetid://243660364"
    particle.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(
            math.min(255, color.R + 100),
            math.min(255, color.G + 50),
            255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)),
    })
    particle.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, size * 0.1),
        NumberSequenceKeypoint.new(0.3, size * 0.6),
        NumberSequenceKeypoint.new(1, size * 0.1),
    })
    particle.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(0.5, 0.5),
        NumberSequenceKeypoint.new(1, 1),
    })
    particle.Lifetime = NumberRange.new(0.4, 0.8)
    particle.Rate = count
    particle.Speed = NumberRange.new(2, 4)
    particle.SpreadAngle = Vector2.new(15, 15)
    particle.Rotation = NumberRange.new(0, 360)
    particle.RotSpeed = NumberRange.new(-30, 30)
    particle.LightEmission = 1
    particle.LightInfluence = 0
    particle.Parent = attach
    group.particle = particle
    group.attach = attach

    local light = Instance.new("PointLight")
    light.Name = "LocalBlueLight"
    light.Color = color
    light.Brightness = 3
    light.Range = size * 2
    light.Parent = proxy
    group.light = light

    return group
end

local function detachAll()
    for proxy, group in pairs(attached) do
        pcall(function()
            if group.fire then group.fire:Destroy() end
            if group.particle then group.particle:Destroy() end
            if group.attach then group.attach:Destroy() end
            if group.light then group.light:Destroy() end
            if proxy and proxy.Parent then proxy:Destroy() end
        end)
    end
    attached = {}
end

local uiRefs = {}

local function attachToChar()
    detachAll()
    if not state.isOn then return end
    local parts = findPart(state.currentPos)
    for _, part in ipairs(parts) do
        local proxy = makeProxy(part)
        local group = buildFire(proxy)
        attached[proxy] = group
    end
    if uiRefs.status then
        uiRefs.status.Text = "  ✓ 挂到 " .. #parts .. " 个部件"
    end
end

