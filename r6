            status.Text = "  已开启"
            status.TextColor3 = Color3.fromRGB(120,220,255)
            wearStatus.Text = string.format("  ✅ 已穿 %d 件 (列表%d+内置%d) + 开火", cnt1+cnt2, cnt1, cnt2)
            wearStatus.TextColor3 = Color3.fromRGB(140,240,160)
        end)
    end)

    -- ★★★ 一键脱光（照搬 R15 逻辑）★★★
    wearNoneBtn.MouseButton1Click:Connect(function()
        wearStatus.Text = "  ⏳ 脱光中..."
        wearStatus.TextColor3 = Color3.fromRGB(255,220,120)
        task.spawn(function()
            -- 先点一遍 R6 列表里的按钮（让 R6 内部状态同步）
            local cnt1 = clickAllAccessoryBtns(false)
            -- 断开自定义配件
            local cnt2 = #customItems
            clearCustomItems()
            -- ★ 调 R15 版脱衣逻辑
            local cnt3 = cleanCharacter()

            -- 关火
            state.isOn = false
            detachAll()
            toggleBtn.Text = "🔥 开火"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(50,130,220)
            status.Text = "  已关闭"
            status.TextColor3 = Color3.fromRGB(180,180,180)

            wearStatus.Text = string.format("  ✅ 已脱光 (R6列表%d + 内置%d + Accoutrement%d) + 关火", cnt1, cnt2, cnt3)
            wearStatus.TextColor3 = Color3.fromRGB(240,200,140)
        end)
    end)
end

