parseBtn.MouseButton1Click:Connect(function()
    local text = dumpInput.Text
    if not text or #text < 10 then title.Text = "请输入 dump 内容" return end
    local parsedAcc, parsedBody = parseDump(text)
    local bodyCount = 0
    for _ in pairs(parsedBody) do bodyCount = bodyCount + 1 end
    if #parsedAcc == 0 and bodyCount == 0 then title.Text = "❌ 未解析到内容" return end
    recordOriginal2D()
    for _, it in ipairs(ACC_ITEMS) do
        if it.conn then it.conn:Disconnect() end
        if it.handle and not it.isWorn then it.handle:Destroy() end
    end
    ACC_ITEMS = parsedAcc
    for _, bIt in ipairs(BODY_ITEMS) do
        if parsedBody[bIt.name] then
            bIt.mesh = parsedBody[bIt.name].mesh
            bIt.tex = parsedBody[bIt.name].tex
            bIt.size = parsedBody[bIt.name].size
        end
    end
    rebuildAccList()
    local count2D = 0
    for _, it in ipairs(parsedAcc) do
        if it.type == "Shirt" or it.type == "Pants" or it.type == "ShirtGraphic" then count2D = count2D + 1 end
    end
    title.Text = string.format("✓ 配件%d (2D:%d) 身体%d", #parsedAcc, count2D, bodyCount)
end)

