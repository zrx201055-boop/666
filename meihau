            end
            stepBtn("0.01", 127, 0.01)
            stepBtn("0.05", 179, 0.05)
            stepBtn("0.1", 231, 0.1)
            stepBtn("0.5", 283, 0.5)

            local expanded = false
            expBtn.MouseButton1Click:Connect(function()
                expanded = not expanded
                panel.Visible = expanded
                expBtn.Text = expanded and "▲" or "▼"
