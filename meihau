local baseSizes = {}
local ratioWide, ratioTall, ratioThick = 1, 1, 1

local function getWideAxis(n)
    if n:find("Arm") or n:find("Hand") then return "Z" end
    return "X"
end

local function saveBaseSizes()
    local c = lp.Character
    if not c then return end
    baseSizes = {}
    for _, name in ipairs(R15_PARTS) do
        local p = c:FindFirstChild(name)
        if p and p:IsA("BasePart") then baseSizes[name] = p.Size end
    end
end

local function applyScale()
    local c = lp.Character
    if not c then return end
    for _, name in ipairs(R15_PARTS) do
        local p = c:FindFirstChild(name)
        if p and p:IsA("BasePart") and baseSizes[name] then
            local b = baseSizes[name]
            local wa = getWideAxis(name)
            local sx, sy, sz = b.X, b.Y, b.Z
            sy = sy * ratioTall
            if wa == "X" then
                sx = sx * ratioWide; sz = sz * ratioThick
            else
                sz = sz * ratioWide; sx = sx * ratioThick
            end
            pcall(function() p.Size = Vector3.new(sx, sy, sz) end)
        end
    end
end

