local function findPart(char, name)
    return char:FindFirstChild(name) or char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
end

local function getOffset(it) return CFrame.new(it.offX, it.offY, it.offZ) end

local function wearAcc(it, btn)
    local char = lp.Character
    if not char then return false end

    if it.type == "Shirt" then
        local s = char:FindFirstChildOfClass("Shirt")
        if not s then s = Instance.new("Shirt"); s.Parent = char end
        s.ShirtTemplate = it.url
        it.handle = s; it.isWorn = true
        if btn then
            btn.BackgroundColor3 = Color3.fromRGB(30, 100, 60)
            btn.Text = "  ● " .. it.name .. "  [2D衬衫]"
        end
        return true
    end
    if it.type == "Pants" then
        local p = char:FindFirstChildOfClass("Pants")
        if not p then p = Instance.new("Pants"); p.Parent = char end
        p.PantsTemplate = it.url
        it.handle = p; it.isWorn = true
        if btn then
            btn.BackgroundColor3 = Color3.fromRGB(30, 100, 60)
            btn.Text = "  ● " .. it.name .. "  [2D裤子]"
        end
        return true
    end
    if it.type == "ShirtGraphic" then
        local g2 = char:FindFirstChildOfClass("ShirtGraphic")
        if not g2 then g2 = Instance.new("ShirtGraphic"); g2.Parent = char end
        g2.Graphic = it.url
        it.handle = g2; it.isWorn = true
        if btn then
            btn.BackgroundColor3 = Color3.fromRGB(30, 100, 60)
            btn.Text = "  ● " .. it.name .. "  [2D T恤]"
        end
        return true
    end

    local p = findPart(char, it.mount)
    if not p then return false end
    local h = Instance.new("MeshPart")
    h.Name = "Item_" .. it.name
    h.MeshId = it.mesh
    h.TextureID = it.tex or ""
    h.Size = Vector3.new(it.size.X * it.sx, it.size.Y * it.sy, it.size.Z * it.sz)
    h.CanCollide = false
    h.Massless = true
    h.Anchored = true
    h:SetAttribute("__Spawned", true)
    h.Parent = char
    it.handle = h
    it.isWorn = false
    it.conn = RunService.RenderStepped:Connect(function()
        if not h or not h.Parent then
            if it.conn then it.conn:Disconnect() it.conn = nil end
            return
        end
        local c = lp.Character
        if not c then return end
        local pp = findPart(c, it.mount)
        if not pp then return end
        h.CFrame = pp.CFrame * getOffset(it)
    end)
    if btn then
        btn.BackgroundColor3 = Color3.fromRGB(30, 100, 60)
        btn.Text = "  ● " .. it.name .. "  [" .. it.type .. "]"
    end
    return true
end

local function removeAcc(it, btn)
    local char = lp.Character
    if it.type == "Shirt" then
        if char then local s = char:FindFirstChildOfClass("Shirt"); if s and originalShirtId then s.ShirtTemplate = originalShirtId end end
        it.handle = nil; it.isWorn = false
        if btn then btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50); btn.Text = "  ○ " .. it.name .. "  [2D衬衫]" end
        return
    end
    if it.type == "Pants" then
        if char then local p = char:FindFirstChildOfClass("Pants"); if p and originalPantsId then p.PantsTemplate = originalPantsId end end
        it.handle = nil; it.isWorn = false
        if btn then btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50); btn.Text = "  ○ " .. it.name .. "  [2D裤子]" end
        return
    end
    if it.type == "ShirtGraphic" then
        if char then local g2 = char:FindFirstChildOfClass("ShirtGraphic"); if g2 and originalTShirtId then g2.Graphic = originalTShirtId end end
        it.handle = nil; it.isWorn = false
        if btn then btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50); btn.Text = "  ○ " .. it.name .. "  [2D T恤]" end
        return
    end
    if it.conn then it.conn:Disconnect() it.conn = nil end
    if it.handle then it.handle:Destroy() it.handle = nil end
    if btn then btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50); btn.Text = "  ○ " .. it.name .. "  [" .. it.type .. "]" end
end

local function refreshAccSize(it)
    if it.handle and it.handle:IsA("MeshPart") then
        it.handle.Size = Vector3.new(it.size.X * it.sx, it.size.Y * it.sy, it.size.Z * it.sz)
    end
end

local function replaceBody(it)
    local char = lp.Character
    if not char then return false end
    local part = char:FindFirstChild(it.part)
    if not part or not part:IsA("MeshPart") then return false end
    if not it.originalMesh then
        it.originalMesh = { mesh = part.MeshId, tex = part.TextureID, size = part.Size }
    end
    if it.mesh and it.mesh ~= "" then pcall(function() part.MeshId = it.mesh end) end
    if it.tex and it.tex ~= "" then pcall(function() part.TextureID = it.tex end) end
    if it.size then
        pcall(function() part.Size = it.size end)
        baseSizes[it.part] = it.size
    end
    it.isReplaced = true
    return true
end

local function restoreBody(it)
    local char = lp.Character
    if not char then return false end
    local part = char:FindFirstChild(it.part)
    if not part or not part:IsA("MeshPart") then return false end
    if it.originalMesh then
        pcall(function()
            part.MeshId = it.originalMesh.mesh
            part.TextureID = it.originalMesh.tex
            part.Size = it.originalMesh.size
        end)
        baseSizes[it.part] = it.originalMesh.size
    end
    it.isReplaced = false
    return true
end

